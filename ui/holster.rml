<rml>
<head>
    <title>Holster</title>
    <link type="text/rcss" href="holster.rcss"/>
</head>
<body data-model="holster">

    <div class="panel" data-if="screen == 'main'">
        <div class="status" data-if="status != ''">{{ status }}</div>
        <div class="hdr">
            <div class="top">
                <span class="h1">HOLSTER</span>
                <span class="badge" data-if="mode == 'exp'">EXPERIMENTAL</span>
                <span class="grow"></span>
                <button id="to_exp" class="modebtn" data-if="mode != 'exp'">Experimental &#8250;</button>
                <button id="to_simple" class="modebtn" data-if="mode == 'exp'">Simple mode &#8250;</button>
            </div>
            <span class="sub">In hand: <span class="blue">{{ inHand }}</span></span>
        </div>

        <div class="card" data-if="mode == 'exp' || sIdx == 1">
            <div class="head">
                <div class="names">
                    <span class="label" data-if="mode == 'exp'">SLOT 1</span>
                    <span class="name" data-class-dim="c1Dim">{{ c1Tool }}</span>
                    <span class="warn" data-if="c1Warn">Take it in hand once to holster it</span>
                </div>
                <button id="c1_show" class="sw"><span class="track" data-class-on="c1ShowOn"><span class="knob"></span></span></button>
            </div>
            <button id="c1_typebtn" class="placebtn" data-class-open="c1TypeOpen">
                <span class="wornon">WORN ON</span><span class="place">{{ c1TypeLabel }}</span>
                <span data-if="!c1TypeOpen"><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 6l5 5 5-5" fill="none" stroke="#FFFFFF" stroke-width="2"/></svg></span><span data-if="c1TypeOpen"><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 11l5-5 5 5" fill="none" stroke="#FFFFFF" stroke-width="2"/></svg></span>
            </button>
            <div class="pop" data-if="c1TypeOpen">
                <button id="c1_t_belt_l" class="opt" data-class-sel="c1On_belt_l"><span class="txt">{{ c1TL_belt_l }}</span><span class="tag" data-if="c1Tag_belt_l != ''">{{ c1Tag_belt_l }}</span></button><button id="c1_t_belt_r" class="opt" data-class-sel="c1On_belt_r"><span class="txt">{{ c1TL_belt_r }}</span><span class="tag" data-if="c1Tag_belt_r != ''">{{ c1Tag_belt_r }}</span></button><button id="c1_t_thigh_l" class="opt" data-class-sel="c1On_thigh_l"><span class="txt">{{ c1TL_thigh_l }}</span><span class="tag" data-if="c1Tag_thigh_l != ''">{{ c1Tag_thigh_l }}</span></button><button id="c1_t_thigh_r" class="opt" data-class-sel="c1On_thigh_r"><span class="txt">{{ c1TL_thigh_r }}</span><span class="tag" data-if="c1Tag_thigh_r != ''">{{ c1Tag_thigh_r }}</span></button><button id="c1_t_back" class="opt" data-class-sel="c1On_back"><span class="txt">{{ c1TL_back }}</span><span class="tag" data-if="c1Tag_back != ''">{{ c1Tag_back }}</span></button><button id="c1_t_backpack" class="opt" data-class-sel="c1On_backpack"><span class="txt">{{ c1TL_backpack }}</span><span class="tag" data-if="c1Tag_backpack != ''">{{ c1Tag_backpack }}</span></button>
            </div>
            <div class="duo">
                <button id="c1_pick" class="btn2" data-if="mode == 'exp'" data-class-open="c1Open">CHOOSE TOOL</button>
                <button id="c1_edit" class="btn2">PLACEMENT</button>
            </div>
            <div class="pop scroll" data-if="c1Open &amp;&amp; mode == 'exp'">
                <button id="c1_cur" class="trow" data-if="c1VC" data-class-sel="c1SelC"><span class="icon cur"></span><span class="col"><span class="l">Current tool</span><span class="s">Whichever is in hand</span></span><span class="tag" data-if="c1TC != ''">{{ c1TC }}</span></button><button id="c1_k0" class="trow" data-if="c1V0" data-class-sel="c1Sel0"><span class="icon" data-class-staff="c1K0 == 'staff'"></span><span class="col"><span class="l">{{ c1L0 }}</span></span><span class="st" data-if="c1S0 != ''" data-class-take="c1SC0 == 'take'" data-class-hand="c1SC0 == 'hand'">{{ c1S0 }}</span><span class="tag" data-if="c1T0 != ''">{{ c1T0 }}</span></button><button id="c1_k1" class="trow" data-if="c1V1" data-class-sel="c1Sel1"><span class="icon" data-class-staff="c1K1 == 'staff'"></span><span class="col"><span class="l">{{ c1L1 }}</span></span><span class="st" data-if="c1S1 != ''" data-class-take="c1SC1 == 'take'" data-class-hand="c1SC1 == 'hand'">{{ c1S1 }}</span><span class="tag" data-if="c1T1 != ''">{{ c1T1 }}</span></button><button id="c1_k2" class="trow" data-if="c1V2" data-class-sel="c1Sel2"><span class="icon" data-class-staff="c1K2 == 'staff'"></span><span class="col"><span class="l">{{ c1L2 }}</span></span><span class="st" data-if="c1S2 != ''" data-class-take="c1SC2 == 'take'" data-class-hand="c1SC2 == 'hand'">{{ c1S2 }}</span><span class="tag" data-if="c1T2 != ''">{{ c1T2 }}</span></button><button id="c1_k3" class="trow" data-if="c1V3" data-class-sel="c1Sel3"><span class="icon" data-class-staff="c1K3 == 'staff'"></span><span class="col"><span class="l">{{ c1L3 }}</span></span><span class="st" data-if="c1S3 != ''" data-class-take="c1SC3 == 'take'" data-class-hand="c1SC3 == 'hand'">{{ c1S3 }}</span><span class="tag" data-if="c1T3 != ''">{{ c1T3 }}</span></button><button id="c1_k4" class="trow" data-if="c1V4" data-class-sel="c1Sel4"><span class="icon" data-class-staff="c1K4 == 'staff'"></span><span class="col"><span class="l">{{ c1L4 }}</span></span><span class="st" data-if="c1S4 != ''" data-class-take="c1SC4 == 'take'" data-class-hand="c1SC4 == 'hand'">{{ c1S4 }}</span><span class="tag" data-if="c1T4 != ''">{{ c1T4 }}</span></button><button id="c1_k5" class="trow" data-if="c1V5" data-class-sel="c1Sel5"><span class="icon" data-class-staff="c1K5 == 'staff'"></span><span class="col"><span class="l">{{ c1L5 }}</span></span><span class="st" data-if="c1S5 != ''" data-class-take="c1SC5 == 'take'" data-class-hand="c1SC5 == 'hand'">{{ c1S5 }}</span><span class="tag" data-if="c1T5 != ''">{{ c1T5 }}</span></button><button id="c1_k6" class="trow" data-if="c1V6" data-class-sel="c1Sel6"><span class="icon" data-class-staff="c1K6 == 'staff'"></span><span class="col"><span class="l">{{ c1L6 }}</span></span><span class="st" data-if="c1S6 != ''" data-class-take="c1SC6 == 'take'" data-class-hand="c1SC6 == 'hand'">{{ c1S6 }}</span><span class="tag" data-if="c1T6 != ''">{{ c1T6 }}</span></button><button id="c1_k7" class="trow" data-if="c1V7" data-class-sel="c1Sel7"><span class="icon" data-class-staff="c1K7 == 'staff'"></span><span class="col"><span class="l">{{ c1L7 }}</span></span><span class="st" data-if="c1S7 != ''" data-class-take="c1SC7 == 'take'" data-class-hand="c1SC7 == 'hand'">{{ c1S7 }}</span><span class="tag" data-if="c1T7 != ''">{{ c1T7 }}</span></button><button id="c1_k8" class="trow" data-if="c1V8" data-class-sel="c1Sel8"><span class="icon" data-class-staff="c1K8 == 'staff'"></span><span class="col"><span class="l">{{ c1L8 }}</span></span><span class="st" data-if="c1S8 != ''" data-class-take="c1SC8 == 'take'" data-class-hand="c1SC8 == 'hand'">{{ c1S8 }}</span><span class="tag" data-if="c1T8 != ''">{{ c1T8 }}</span></button><button id="c1_k9" class="trow" data-if="c1V9" data-class-sel="c1Sel9"><span class="icon" data-class-staff="c1K9 == 'staff'"></span><span class="col"><span class="l">{{ c1L9 }}</span></span><span class="st" data-if="c1S9 != ''" data-class-take="c1SC9 == 'take'" data-class-hand="c1SC9 == 'hand'">{{ c1S9 }}</span><span class="tag" data-if="c1T9 != ''">{{ c1T9 }}</span></button><button id="c1_k10" class="trow" data-if="c1V10" data-class-sel="c1Sel10"><span class="icon" data-class-staff="c1K10 == 'staff'"></span><span class="col"><span class="l">{{ c1L10 }}</span></span><span class="st" data-if="c1S10 != ''" data-class-take="c1SC10 == 'take'" data-class-hand="c1SC10 == 'hand'">{{ c1S10 }}</span><span class="tag" data-if="c1T10 != ''">{{ c1T10 }}</span></button><button id="c1_k11" class="trow" data-if="c1V11" data-class-sel="c1Sel11"><span class="icon" data-class-staff="c1K11 == 'staff'"></span><span class="col"><span class="l">{{ c1L11 }}</span></span><span class="st" data-if="c1S11 != ''" data-class-take="c1SC11 == 'take'" data-class-hand="c1SC11 == 'hand'">{{ c1S11 }}</span><span class="tag" data-if="c1T11 != ''">{{ c1T11 }}</span></button><button id="c1_k12" class="trow" data-if="c1V12" data-class-sel="c1Sel12"><span class="icon" data-class-staff="c1K12 == 'staff'"></span><span class="col"><span class="l">{{ c1L12 }}</span></span><span class="st" data-if="c1S12 != ''" data-class-take="c1SC12 == 'take'" data-class-hand="c1SC12 == 'hand'">{{ c1S12 }}</span><span class="tag" data-if="c1T12 != ''">{{ c1T12 }}</span></button><button id="c1_k13" class="trow" data-if="c1V13" data-class-sel="c1Sel13"><span class="icon" data-class-staff="c1K13 == 'staff'"></span><span class="col"><span class="l">{{ c1L13 }}</span></span><span class="st" data-if="c1S13 != ''" data-class-take="c1SC13 == 'take'" data-class-hand="c1SC13 == 'hand'">{{ c1S13 }}</span><span class="tag" data-if="c1T13 != ''">{{ c1T13 }}</span></button><button id="c1_k14" class="trow" data-if="c1V14" data-class-sel="c1Sel14"><span class="icon" data-class-staff="c1K14 == 'staff'"></span><span class="col"><span class="l">{{ c1L14 }}</span></span><span class="st" data-if="c1S14 != ''" data-class-take="c1SC14 == 'take'" data-class-hand="c1SC14 == 'hand'">{{ c1S14 }}</span><span class="tag" data-if="c1T14 != ''">{{ c1T14 }}</span></button><button id="c1_k15" class="trow" data-if="c1V15" data-class-sel="c1Sel15"><span class="icon" data-class-staff="c1K15 == 'staff'"></span><span class="col"><span class="l">{{ c1L15 }}</span></span><span class="st" data-if="c1S15 != ''" data-class-take="c1SC15 == 'take'" data-class-hand="c1SC15 == 'hand'">{{ c1S15 }}</span><span class="tag" data-if="c1T15 != ''">{{ c1T15 }}</span></button>
            </div>
        </div>

        <div class="card" data-if="mode == 'exp' || sIdx == 2">
            <div class="head">
                <div class="names">
                    <span class="label" data-if="mode == 'exp'">SLOT 2</span>
                    <span class="name" data-class-dim="c2Dim">{{ c2Tool }}</span>
                    <span class="warn" data-if="c2Warn">Take it in hand once to holster it</span>
                </div>
                <button id="c2_show" class="sw"><span class="track" data-class-on="c2ShowOn"><span class="knob"></span></span></button>
            </div>
            <button id="c2_typebtn" class="placebtn" data-class-open="c2TypeOpen">
                <span class="wornon">WORN ON</span><span class="place">{{ c2TypeLabel }}</span>
                <span data-if="!c2TypeOpen"><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 6l5 5 5-5" fill="none" stroke="#FFFFFF" stroke-width="2"/></svg></span><span data-if="c2TypeOpen"><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 11l5-5 5 5" fill="none" stroke="#FFFFFF" stroke-width="2"/></svg></span>
            </button>
            <div class="pop" data-if="c2TypeOpen">
                <button id="c2_t_belt_l" class="opt" data-class-sel="c2On_belt_l"><span class="txt">{{ c2TL_belt_l }}</span><span class="tag" data-if="c2Tag_belt_l != ''">{{ c2Tag_belt_l }}</span></button><button id="c2_t_belt_r" class="opt" data-class-sel="c2On_belt_r"><span class="txt">{{ c2TL_belt_r }}</span><span class="tag" data-if="c2Tag_belt_r != ''">{{ c2Tag_belt_r }}</span></button><button id="c2_t_thigh_l" class="opt" data-class-sel="c2On_thigh_l"><span class="txt">{{ c2TL_thigh_l }}</span><span class="tag" data-if="c2Tag_thigh_l != ''">{{ c2Tag_thigh_l }}</span></button><button id="c2_t_thigh_r" class="opt" data-class-sel="c2On_thigh_r"><span class="txt">{{ c2TL_thigh_r }}</span><span class="tag" data-if="c2Tag_thigh_r != ''">{{ c2Tag_thigh_r }}</span></button><button id="c2_t_back" class="opt" data-class-sel="c2On_back"><span class="txt">{{ c2TL_back }}</span><span class="tag" data-if="c2Tag_back != ''">{{ c2Tag_back }}</span></button><button id="c2_t_backpack" class="opt" data-class-sel="c2On_backpack"><span class="txt">{{ c2TL_backpack }}</span><span class="tag" data-if="c2Tag_backpack != ''">{{ c2Tag_backpack }}</span></button>
            </div>
            <div class="duo">
                <button id="c2_pick" class="btn2" data-if="mode == 'exp'" data-class-open="c2Open">CHOOSE TOOL</button>
                <button id="c2_edit" class="btn2">PLACEMENT</button>
            </div>
            <div class="pop scroll" data-if="c2Open &amp;&amp; mode == 'exp'">
                <button id="c2_cur" class="trow" data-if="c2VC" data-class-sel="c2SelC"><span class="icon cur"></span><span class="col"><span class="l">Current tool</span><span class="s">Whichever is in hand</span></span><span class="tag" data-if="c2TC != ''">{{ c2TC }}</span></button><button id="c2_k0" class="trow" data-if="c2V0" data-class-sel="c2Sel0"><span class="icon" data-class-staff="c2K0 == 'staff'"></span><span class="col"><span class="l">{{ c2L0 }}</span></span><span class="st" data-if="c2S0 != ''" data-class-take="c2SC0 == 'take'" data-class-hand="c2SC0 == 'hand'">{{ c2S0 }}</span><span class="tag" data-if="c2T0 != ''">{{ c2T0 }}</span></button><button id="c2_k1" class="trow" data-if="c2V1" data-class-sel="c2Sel1"><span class="icon" data-class-staff="c2K1 == 'staff'"></span><span class="col"><span class="l">{{ c2L1 }}</span></span><span class="st" data-if="c2S1 != ''" data-class-take="c2SC1 == 'take'" data-class-hand="c2SC1 == 'hand'">{{ c2S1 }}</span><span class="tag" data-if="c2T1 != ''">{{ c2T1 }}</span></button><button id="c2_k2" class="trow" data-if="c2V2" data-class-sel="c2Sel2"><span class="icon" data-class-staff="c2K2 == 'staff'"></span><span class="col"><span class="l">{{ c2L2 }}</span></span><span class="st" data-if="c2S2 != ''" data-class-take="c2SC2 == 'take'" data-class-hand="c2SC2 == 'hand'">{{ c2S2 }}</span><span class="tag" data-if="c2T2 != ''">{{ c2T2 }}</span></button><button id="c2_k3" class="trow" data-if="c2V3" data-class-sel="c2Sel3"><span class="icon" data-class-staff="c2K3 == 'staff'"></span><span class="col"><span class="l">{{ c2L3 }}</span></span><span class="st" data-if="c2S3 != ''" data-class-take="c2SC3 == 'take'" data-class-hand="c2SC3 == 'hand'">{{ c2S3 }}</span><span class="tag" data-if="c2T3 != ''">{{ c2T3 }}</span></button><button id="c2_k4" class="trow" data-if="c2V4" data-class-sel="c2Sel4"><span class="icon" data-class-staff="c2K4 == 'staff'"></span><span class="col"><span class="l">{{ c2L4 }}</span></span><span class="st" data-if="c2S4 != ''" data-class-take="c2SC4 == 'take'" data-class-hand="c2SC4 == 'hand'">{{ c2S4 }}</span><span class="tag" data-if="c2T4 != ''">{{ c2T4 }}</span></button><button id="c2_k5" class="trow" data-if="c2V5" data-class-sel="c2Sel5"><span class="icon" data-class-staff="c2K5 == 'staff'"></span><span class="col"><span class="l">{{ c2L5 }}</span></span><span class="st" data-if="c2S5 != ''" data-class-take="c2SC5 == 'take'" data-class-hand="c2SC5 == 'hand'">{{ c2S5 }}</span><span class="tag" data-if="c2T5 != ''">{{ c2T5 }}</span></button><button id="c2_k6" class="trow" data-if="c2V6" data-class-sel="c2Sel6"><span class="icon" data-class-staff="c2K6 == 'staff'"></span><span class="col"><span class="l">{{ c2L6 }}</span></span><span class="st" data-if="c2S6 != ''" data-class-take="c2SC6 == 'take'" data-class-hand="c2SC6 == 'hand'">{{ c2S6 }}</span><span class="tag" data-if="c2T6 != ''">{{ c2T6 }}</span></button><button id="c2_k7" class="trow" data-if="c2V7" data-class-sel="c2Sel7"><span class="icon" data-class-staff="c2K7 == 'staff'"></span><span class="col"><span class="l">{{ c2L7 }}</span></span><span class="st" data-if="c2S7 != ''" data-class-take="c2SC7 == 'take'" data-class-hand="c2SC7 == 'hand'">{{ c2S7 }}</span><span class="tag" data-if="c2T7 != ''">{{ c2T7 }}</span></button><button id="c2_k8" class="trow" data-if="c2V8" data-class-sel="c2Sel8"><span class="icon" data-class-staff="c2K8 == 'staff'"></span><span class="col"><span class="l">{{ c2L8 }}</span></span><span class="st" data-if="c2S8 != ''" data-class-take="c2SC8 == 'take'" data-class-hand="c2SC8 == 'hand'">{{ c2S8 }}</span><span class="tag" data-if="c2T8 != ''">{{ c2T8 }}</span></button><button id="c2_k9" class="trow" data-if="c2V9" data-class-sel="c2Sel9"><span class="icon" data-class-staff="c2K9 == 'staff'"></span><span class="col"><span class="l">{{ c2L9 }}</span></span><span class="st" data-if="c2S9 != ''" data-class-take="c2SC9 == 'take'" data-class-hand="c2SC9 == 'hand'">{{ c2S9 }}</span><span class="tag" data-if="c2T9 != ''">{{ c2T9 }}</span></button><button id="c2_k10" class="trow" data-if="c2V10" data-class-sel="c2Sel10"><span class="icon" data-class-staff="c2K10 == 'staff'"></span><span class="col"><span class="l">{{ c2L10 }}</span></span><span class="st" data-if="c2S10 != ''" data-class-take="c2SC10 == 'take'" data-class-hand="c2SC10 == 'hand'">{{ c2S10 }}</span><span class="tag" data-if="c2T10 != ''">{{ c2T10 }}</span></button><button id="c2_k11" class="trow" data-if="c2V11" data-class-sel="c2Sel11"><span class="icon" data-class-staff="c2K11 == 'staff'"></span><span class="col"><span class="l">{{ c2L11 }}</span></span><span class="st" data-if="c2S11 != ''" data-class-take="c2SC11 == 'take'" data-class-hand="c2SC11 == 'hand'">{{ c2S11 }}</span><span class="tag" data-if="c2T11 != ''">{{ c2T11 }}</span></button><button id="c2_k12" class="trow" data-if="c2V12" data-class-sel="c2Sel12"><span class="icon" data-class-staff="c2K12 == 'staff'"></span><span class="col"><span class="l">{{ c2L12 }}</span></span><span class="st" data-if="c2S12 != ''" data-class-take="c2SC12 == 'take'" data-class-hand="c2SC12 == 'hand'">{{ c2S12 }}</span><span class="tag" data-if="c2T12 != ''">{{ c2T12 }}</span></button><button id="c2_k13" class="trow" data-if="c2V13" data-class-sel="c2Sel13"><span class="icon" data-class-staff="c2K13 == 'staff'"></span><span class="col"><span class="l">{{ c2L13 }}</span></span><span class="st" data-if="c2S13 != ''" data-class-take="c2SC13 == 'take'" data-class-hand="c2SC13 == 'hand'">{{ c2S13 }}</span><span class="tag" data-if="c2T13 != ''">{{ c2T13 }}</span></button><button id="c2_k14" class="trow" data-if="c2V14" data-class-sel="c2Sel14"><span class="icon" data-class-staff="c2K14 == 'staff'"></span><span class="col"><span class="l">{{ c2L14 }}</span></span><span class="st" data-if="c2S14 != ''" data-class-take="c2SC14 == 'take'" data-class-hand="c2SC14 == 'hand'">{{ c2S14 }}</span><span class="tag" data-if="c2T14 != ''">{{ c2T14 }}</span></button><button id="c2_k15" class="trow" data-if="c2V15" data-class-sel="c2Sel15"><span class="icon" data-class-staff="c2K15 == 'staff'"></span><span class="col"><span class="l">{{ c2L15 }}</span></span><span class="st" data-if="c2S15 != ''" data-class-take="c2SC15 == 'take'" data-class-hand="c2SC15 == 'hand'">{{ c2S15 }}</span><span class="tag" data-if="c2T15 != ''">{{ c2T15 }}</span></button>
            </div>
        </div>

        <div class="card" data-if="mode == 'exp' || sIdx == 3">
            <div class="head">
                <div class="names">
                    <span class="label" data-if="mode == 'exp'">SLOT 3</span>
